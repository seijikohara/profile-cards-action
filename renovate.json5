{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Shared policy: https://github.com/seijikohara/renovate-config
  extends: ['github>seijikohara/renovate-config:default.json5'],
  // This repository is a JavaScript (Node.js) GitHub Action.
  enabledManagers: ['npm', 'github-actions'],
  // CI commits the built `dist/` back onto the pull request branch. Without this,
  // Renovate reads that commit as a manual edit, marks the pull request
  // "PR Edited (Blocked)" on the dependency dashboard, and stops rebasing it.
  gitIgnoredAuthors: ['development-automation-bot[bot]@users.noreply.github.com'],
  packageRules: [
    {
      description: 'Group npm dependencies',
      matchManagers: ['npm'],
      groupName: 'npm dependencies',
    },
    {
      // oxlint declares the oxlint-tsgolint version it needs as a peer dependency,
      // and oxlint-tsgolint moves to a new major with TypeScript. Keep majors in the
      // same PR so oxlint never lands without a matching oxlint-tsgolint.
      description: 'Group the oxc linting and formatting toolchain',
      groupName: 'linting and formatting',
      matchPackageNames: ['oxlint', 'oxfmt', 'oxlint-tsgolint'],
      separateMajorMinor: false,
    },
    {
      description: 'Group the test toolchain',
      groupName: 'testing',
      matchPackageNames: ['vitest'],
    },
    {
      description: 'Group the build toolchain',
      groupName: 'build toolchain',
      matchPackageNames: ['typescript', 'tsdown', 'lefthook'],
    },
    {
      description: 'Group TypeScript type definitions',
      groupName: 'type definitions',
      matchPackageNames: ['@types/*'],
    },
  ],
}
